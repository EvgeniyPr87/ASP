@page "/TaskList"
@rendermode InteractiveServer
@using ToDoList

<h3>TaskList</h3>
<input type="text" @bind ="description"/>
<button class="btn btn-primary" @onclick="AddTask">Добавить</button>

<ul>
	@foreach (var task in tasklist)
	{
				<li>
					<input type="checkbox" @bind="task.DONE" />
					<span class="@(task.DONE ? "text-decoration-line-through" : "")">
				@task.Description
					</span>
				</li>
	}
	</ul>

@code {
    private string description = "";
    private List<TODO> tasklist = new List<TODO>();

    protected override void OnInitialized()
    {
        tasklist = new List<TODO>
        {
            new TODO { Description = "Полить цветы" },
            new TODO { Description = "Покормить кота", DONE = true },
            new TODO { Description = "Сходить в магазин", DONE = true }
        };
    }

    private void AddTask()
    {
        if (string.IsNullOrWhiteSpace(description))
            return;

        tasklist.Add(new TODO { Description = description.Trim() });
        description = "";
    }
}
