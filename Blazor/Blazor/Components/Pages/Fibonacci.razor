@page "/Fibonacci"
@rendermode InteractiveServer

<h1>Fibonacci</h1>

<div>
	<h3>Введите количество чисел:</h3>
	<input type="number" min="1" max="50" @bind="num" @bind:after="FibCreate" />
</div>

<h3>Ряд Фибоначчи:</h3>
@if(result!=null)
{
<div class="alert alert-info">
	@string.Join(",",result)
</div>
}
@code {

}
