@page "/Fibonacci"
@rendermode InteractiveServer

<h1 class="fibonacci-title">Fibonacci</h1>

<div class="alert alert-primary">
	<h3>Введите количество чисел:</h3>
	<input class="fibonacci-input" type="number" min="1" max="30" @bind="num" @bind:event="oninput" />

	<button class="fibonacci-button" @onclick="FibCreate"> Показать</button>
	
</div>

<h3 class="fibonacci-h3-result" >Ряд Фибоначчи:</h3>
@if(result!=null)
{
	<div class="alert alert-primary" >
		
				@string.Join(",", result)
		
</div>
}

